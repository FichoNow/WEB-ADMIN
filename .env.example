# ───────────────────────────────────────────────────────────────
# Configuración de la web (WEB-ADMIN)
# Copia este archivo a `.env` y ajusta los valores según el entorno.
# ───────────────────────────────────────────────────────────────

# URL del backend (API). Si no se define, usa http://localhost:3000.
# En local y en el servidor la API corre en localhost:3000, así que normalmente
# no hace falta tocarlo.
API_URL=http://localhost:3000

# Forzar HTTPS.
#   true  -> cookies con flag `Secure` (solo viajan por HTTPS) + redirección
#            automática de HTTP a HTTPS. Úsalo en el SERVIDOR (detrás del túnel HTTPS).
#   false -> cookies normales y sin redirección. Úsalo en TU PC para hacer
#            pruebas en HTTP (localhost) sin problemas de sesión.
FORCE_HTTPS=false
